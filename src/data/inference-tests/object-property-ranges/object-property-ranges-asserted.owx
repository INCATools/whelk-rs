<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.example.org/object-property-ranges"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.example.org/object-property-ranges">
    <Prefix name="" IRI="http://www.example.org/object-property-ranges#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Declaration>
        <Class IRI="#Source"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Filler"/>
    </Declaration>
    <Declaration>
        <Class IRI="#RangeA"/>
    </Declaration>
    <Declaration>
        <Class IRI="#RangeB"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Target"/>
    </Declaration>
    <Declaration>
        <Class IRI="#p_some_RangeA"/>
    </Declaration>
    <Declaration>
        <Class IRI="#q_some_RangeB"/>
    </Declaration>
    <Declaration>
        <Class IRI="#t_some_Target"/>
    </Declaration>
    <Declaration>
        <Class IRI="#BadSource"/>
    </Declaration>
    <Declaration>
        <Class IRI="#BadFiller"/>
    </Declaration>
    <Declaration>
        <Class IRI="#BadRange"/>
    </Declaration>
    <Declaration>
        <Class IRI="#SelfSource"/>
    </Declaration>
    <Declaration>
        <Class IRI="#SelfRange"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#r"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#p"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#q"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#s"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#t"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#bad_r"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#self_r"/>
    </Declaration>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#r"/>
        <ObjectProperty IRI="#p"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#r"/>
        <ObjectProperty IRI="#q"/>
    </SubObjectPropertyOf>
    <SubObjectPropertyOf>
        <ObjectPropertyChain>
            <ObjectProperty IRI="#r"/>
            <ObjectProperty IRI="#s"/>
        </ObjectPropertyChain>
        <ObjectProperty IRI="#t"/>
    </SubObjectPropertyOf>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#p"/>
        <Class IRI="#RangeA"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#q"/>
        <Class IRI="#RangeB"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#bad_r"/>
        <Class IRI="#BadRange"/>
    </ObjectPropertyRange>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#self_r"/>
        <Class IRI="#SelfRange"/>
    </ObjectPropertyRange>
    <SubClassOf>
        <Class IRI="#Source"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#r"/>
            <Class IRI="#Filler"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#RangeA"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#s"/>
            <Class IRI="#Target"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <EquivalentClasses>
        <Class IRI="#p_some_RangeA"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#p"/>
            <Class IRI="#RangeA"/>
        </ObjectSomeValuesFrom>
    </EquivalentClasses>
    <EquivalentClasses>
        <Class IRI="#q_some_RangeB"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#q"/>
            <Class IRI="#RangeB"/>
        </ObjectSomeValuesFrom>
    </EquivalentClasses>
    <EquivalentClasses>
        <Class IRI="#t_some_Target"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#t"/>
            <Class IRI="#Target"/>
        </ObjectSomeValuesFrom>
    </EquivalentClasses>
    <SubClassOf>
        <Class IRI="#BadSource"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#bad_r"/>
            <Class IRI="#BadFiller"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <DisjointClasses>
        <Class IRI="#BadFiller"/>
        <Class IRI="#BadRange"/>
    </DisjointClasses>
    <SubClassOf>
        <Class IRI="#SelfSource"/>
        <ObjectHasSelf>
            <ObjectProperty IRI="#self_r"/>
        </ObjectHasSelf>
    </SubClassOf>
</Ontology>
