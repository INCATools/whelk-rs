<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.example.org/object-property-ranges"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.example.org/object-property-ranges">
    <Prefix name="" IRI="http://www.example.org/object-property-ranges#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Declaration>
        <Class IRI="#Filler"/>
    </Declaration>
    <Declaration>
        <Class IRI="#RangeA"/>
    </Declaration>
    <Declaration>
        <Class IRI="#RangeB"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Source"/>
    </Declaration>
    <Declaration>
        <Class IRI="#Target"/>
    </Declaration>
    <Declaration>
        <Class IRI="#BadFiller"/>
    </Declaration>
    <SubClassOf>
        <Class IRI="#Filler"/>
        <Class IRI="#RangeA"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Filler"/>
        <Class IRI="#RangeB"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#Source"/>
        <Class IRI="#Target"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#BadFiller"/>
        <Class IRI="http://www.w3.org/2002/07/owl#Nothing"/>
    </SubClassOf>
</Ontology>
